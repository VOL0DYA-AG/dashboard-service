FROM node:22-alpine AS build
WORKDIR /src
COPY contract ./contract
COPY ui/cabinet/package.json ui/cabinet/package-lock.json ./ui/cabinet/
WORKDIR /src/ui/cabinet
RUN npm ci
COPY ui/cabinet ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/40-write-config.sh /docker-entrypoint.d/40-write-config.sh
RUN chmod +x /docker-entrypoint.d/40-write-config.sh
COPY --from=build /src/ui/cabinet/dist /usr/share/nginx/html/cabinet
