# Уже работающий OpenRemote. Этот файл его не запускает.
MANAGER_URL=https://212.22.82.167
KEYCLOAK_URL=https://212.22.82.167/auth

# Адрес кабинета так, как его открывают в браузере. Без слэша в конце.
# Порт 8090 — потому что 80 и 443 на 195.170.163.72 уже заняты.
CABINET_URL=http://195.170.163.72:8090
CABINET_PORT=8090

# Пароль администратора того OpenRemote. Пользователь по умолчанию admin.
OR_ADMIN_USER=admin
OR_ADMIN_PASSWORD=секрет-админа-этого-openremote

# Сертификат OpenRemote самоподписанный и выписан на localhost.
# Строка нужна скрипту настройки, чтобы он смог подключиться.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Вход, который скрипт создаст для человека в кабинете.
OPERATOR_USER=operator
OPERATOR_PASSWORD=operator

# Область в OpenRemote. Отдельный «дом», чтобы кабинет не смешался с другими объектами.
CABINET_REALM=boiler
PLANT_NAME=Котельная, дом 12

# false — только создать карточки и не трогать цифры датчиков.
# true — пока скрипт запущен, он сам двигает температуры. Для проверки без настоящего котла.
SIM_LOOP=false
# true — попытаться записать шесть часов истории для графиков.
SIM_BACKFILL=false
# true — заново поставить пароль оператора, если пользователь уже был.
RESET_OPERATOR_PASSWORD=false
